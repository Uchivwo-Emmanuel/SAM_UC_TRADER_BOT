# Public browser configuration only.
# Never put broker, database, Better Auth secrets, SMTP credentials, or OpenAI keys here.
VITE_APP_NAME=AI Trading Bot
VITE_API_BASE_URL=http://localhost:3000
VITE_AUTH_BASE_URL=http://localhost:3000
VITE_REALTIME_BASE_URL=ws://localhost:3000
VITE_APP_TIME_ZONE=Africa/Lagos
VITE_SENTRY_DSN=

# UI flags — these change display behavior only; backend controls every trading permission.
VITE_ENABLE_DEMO_DATA=true
VITE_READ_ONLY_DASHBOARD=true
VITE_SHOW_KILL_SWITCH_STATUS=true

# Trigger.dev is backend-only. No Trigger.dev secret or project identifier belongs here.
