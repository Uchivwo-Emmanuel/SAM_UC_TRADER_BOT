[Unit]
Description=SAM UC Trader Bot API (demo-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=traderbot
Group=traderbot
WorkingDirectory=/opt/sam-uc-trader-bot/backend
Environment=NODE_ENV=production
Environment=PATH=/home/traderbot/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/etc/sam-uc-trader-bot/backend.env
ExecStart=/home/traderbot/.local/bin/npm run start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/sam-uc-trader-bot/backend/storage

[Install]
WantedBy=multi-user.target
