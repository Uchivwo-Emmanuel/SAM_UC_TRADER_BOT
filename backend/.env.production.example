# Backend production configuration — copy to a VPS-owned secret file, not into Git.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
APP_TIME_ZONE=Africa/Lagos
API_PUBLIC_URL=https://sammyucfx.name.ng
FRONTEND_PUBLIC_URL=https://sammyucfx.name.ng
CORS_ORIGIN=https://sammyucfx.name.ng
INSTANCE_ROLE=api

# Server-only secrets
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://sammyucfx.name.ng
ANALYSIS_SERVICE_TOKEN=
OPENAI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Deriv: demo only until a separately reviewed live-trading release.
DERIV_ACCOUNT_MODE=demo
LIVE_TRADING_ENABLED=false
DERIV_OAUTH_ENABLED=false
DERIV_OAUTH_CLIENT_ID=
DERIV_OAUTH_REDIRECT_URI=https://sammyucfx.name.ng/api/auth/deriv/callback
DERIV_OAUTH_SCOPES=trade
DERIV_OAUTH_TOKEN_ENCRYPTION_KEY=

# Browser-safe behavior is controlled at build time in frontend/.env.production.
