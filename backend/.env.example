# Runtime and deployment
NODE_ENV=development
PORT=3000
BIND_HOST=127.0.0.1
LOG_LEVEL=info
APP_TIME_ZONE=Africa/Lagos
API_PUBLIC_URL=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
INSTANCE_ROLE=api

# PostgreSQL / Supabase (server-only)
DATABASE_URL=
DATABASE_POOL_MAX=10
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Better Auth (server-only)
# Generate at least 32 high-entropy characters; do not expose it to the browser.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
AUTH_INVITE_ONLY=true
# Comma-separated owner email allow-list. Required by the provisioning command;
# this is not a frontend setting and must not contain passwords.
AUTH_ALLOWED_EMAILS=
BETTER_AUTH_API_KEY=

# Deriv (server-only). Do not put tokens in frontend configuration.
DERIV_APP_ID=
DERIV_API_TOKEN=
DERIV_ACCOUNT_ID=
DERIV_WEBSOCKET_URL=wss://ws.derivws.com/websockets/v3
# OAuth is off until the registered redirect URL and encryption key are configured.
DERIV_OAUTH_ENABLED=false
DERIV_OAUTH_CLIENT_ID=
DERIV_OAUTH_REDIRECT_URI=https://sammyucfx.name.ng/api/auth/deriv/callback
# Use only the scopes registered with Deriv. Payment and account-management scopes are intentionally excluded.
DERIV_OAUTH_SCOPES=trade
# Exactly 64 hexadecimal characters (32 random bytes). Server-only; never commit this value.
DERIV_OAUTH_TOKEN_ENCRYPTION_KEY=
# Keep false until every live-trading approval gate has passed.
LIVE_TRADING_ENABLED=false
# Use the account type actually provisioned at Deriv; validate it against the broker account.
DERIV_ACCOUNT_MODE=demo
DERIV_TRADING_ACCOUNT_TYPE=standard
DERIV_ALLOWED_INSTRUMENTS=XAUUSD,VOLATILITY_100,JUMP_50

# Trading safety and risk limits
# This must be resolved before live trading: loss at stop vs capital allocated are different limits.
MAX_LOSS_PER_TRADE_PERCENT=
MAX_POSITION_ALLOCATION_PERCENT=
MAX_DAILY_LOSS_PERCENT=50
MAX_TOTAL_DRAWDOWN_PERCENT=50
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=
REQUIRE_STOP_LOSS=true
REQUIRE_TAKE_PROFIT=true
FORBID_MARTINGALE=true
FORBID_AVERAGING_DOWN=true
FORBID_GRID_TRADING=true
KILL_SWITCH_ENABLED=true
CLOSE_OPEN_POSITIONS_ON_KILL_SWITCH=true
KILL_SWITCH_CLOSE_RETRY_MAX_ATTEMPTS=5
KILL_SWITCH_CLOSE_RETRY_DELAY_SECONDS=15

# Broker and infrastructure failure behavior
PAUSE_NEW_ENTRIES_ON_BROKER_FAILURE=true
PAUSE_NEW_ENTRIES_ON_STALE_MARKET_DATA=true
MARKET_DATA_STALE_AFTER_SECONDS=30
ALERT_ON_BROKER_FAILURE=true
ALERT_ON_WORKER_FAILURE=true

# Strategy intake, approval, and testing
STRATEGY_PDF_UPLOAD_ENABLED=true
STRATEGY_PDF_STORAGE_PATH=./storage/strategy-submissions
STRATEGY_PDF_MAX_SIZE_MB=10
# Source PDF deletion is a manual owner action after code conversion.
STRATEGY_PDF_AUTO_DELETE=false
REQUIRE_TWO_OWNER_STRATEGY_APPROVAL=true
STRATEGY_PAPER_TEST_MIN_DAYS=7
STRATEGY_PAPER_TEST_MIN_TRADES=
STRATEGY_PAPER_TEST_MAX_DRAWDOWN_PERCENT=
STRATEGY_PAPER_TEST_MIN_WIN_RATE_PERCENT=
STRATEGY_PAPER_TEST_MIN_PROFIT_FACTOR=

# Owner alerts (server-only SMTP credentials)
OWNER_ALERT_EMAILS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
EMAIL_ALERTS_ENABLED=false
IN_APP_ALERTS_ENABLED=true

# OpenAI reporting worker (server-only)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_DAILY_ANALYSIS_ENABLED=false
AI_INPUT_MODE=summarized_indicators
AI_DAILY_REPORT_MODE=descriptive_only
# Dedicated identity for scoped internal read endpoints; never a database credential.
ANALYSIS_SERVICE_TOKEN=replace-with-a-long-random-secret
ANALYSIS_INTERNAL_API_BASE_URL=http://localhost:3000
ANALYSIS_REPORT_RETRY_ENABLED=true
ANALYSIS_MISSED_REPORT_RETRY_MAX_DAYS=1

# Trigger.dev background jobs (server-only)
# Use this for scheduled analysis, retries, notifications, and retention jobs — not the live Deriv websocket/trading loop.
TRIGGER_DEV_ENABLED=false
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
TRIGGER_ENVIRONMENT=dev

# Scheduling, storage, and retention
DAILY_ANALYSIS_CRON=0 0 * * *
WEEKLY_STRATEGY_CRON=0 1 * * 0
REPORT_STORAGE_PATH=./storage/reports
TRADE_LOG_RETENTION_DAYS=365
AI_REPORT_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=365

# Observability
SENTRY_DSN=
